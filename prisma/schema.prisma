generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["sigyn"]
}

model Role {
  id_role       Int      @id @default(autoincrement())
  role_code     String   @unique
  name          String
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  user_roles User_Role[]

  @@index([status])
  @@schema("sigyn")
}

model User {
  id_user       Int      @id @default(autoincrement())
  email         String   @unique
  password      String
  full_name     String
  phone         String?
  avatar_url    String?
  is_active     Boolean  @default(true)
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  vendor     Vendor?
  bookings   Booking[]      @relation("CustomerBookings")
  reviews    Review[]
  user_roles User_Role[]
  favorites  UserFavorite[]
  cart       Cart?

  @@index([status])
  @@schema("sigyn")
}

model User_Role {
  iduser_role   Int      @id @default(autoincrement())
  email         String
  role_code     String
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  user User @relation(fields: [email], references: [email])
  role Role @relation(fields: [role_code], references: [role_code])

  @@unique([email, role_code])
  @@index([status])
  @@schema("sigyn")
}

model Vendor {
  id_vendor     Int       @id @default(autoincrement())
  id_user       Int       @unique
  vendor_code   String    @unique @default(uuid())
  business_name String
  description   String?
  category      String
  location      String?
  years_exp     Int       @default(0)
  status        String    @default("pending")
  verified_at   DateTime?
  date_created  DateTime  @default(now())
  date_modified DateTime  @updatedAt
  user_created  String?
  user_modified String?

  user         User                 @relation(fields: [id_user], references: [id_user])
  portfolios   Portfolio[]
  packages     Package[]
  availability VendorAvailability[]
  reviews      Review[]
  commissions  Commission[]

  @@index([status])
  @@schema("sigyn")
}

model Category {
  id_category   Int      @id @default(autoincrement())
  category_name String   @unique
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  packages   Package[]
  portfolios Portfolio[]

  @@index([status])
  @@schema("sigyn")
}

model Portfolio {
  id_portfolio  Int      @id @default(autoincrement())
  id_vendor     Int
  id_package    Int?
  id_category   Int?
  title         String
  code          String   @unique
  description   String?
  cover_url     String
  location      String?
  label         String?
  sort_order    Int      @default(0)
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  vendor   Vendor           @relation(fields: [id_vendor], references: [id_vendor])
  package  Package?         @relation(fields: [id_package], references: [id_package])
  category Category?        @relation(fields: [id_category], references: [id_category])
  images   PortfolioImage[]

  @@index([id_vendor])
  @@index([id_package])
  @@index([id_category])
  @@schema("sigyn")
}

model PortfolioImage {
  id_image     Int      @id @default(autoincrement())
  id_portfolio Int
  image_url    String
  caption      String?
  sort_order   Int      @default(0)
  date_created DateTime @default(now())

  portfolio Portfolio @relation(fields: [id_portfolio], references: [id_portfolio], onDelete: Cascade)

  @@schema("sigyn")
}

model Package {
  id_package     Int      @id @default(autoincrement())
  id_vendor      Int
  id_category    Int?
  name           String
  description    String?
  price          Float
  duration       String?
  whats_included String?
  status         String   @default("active")
  date_created   DateTime @default(now())
  date_modified  DateTime @updatedAt
  user_created   String?
  user_modified  String?

  vendor           Vendor           @relation(fields: [id_vendor], references: [id_vendor])
  category         Category?        @relation(fields: [id_category], references: [id_category])
  booking_packages BookingPackage[]
  portfolios       Portfolio[]
  favorites        UserFavorite[]
  cart_items       CartItem[]

  @@index([id_vendor])
  @@index([id_category])
  @@index([status])
  @@schema("sigyn")
}

model VendorAvailability {
  id_availability Int      @id @default(autoincrement())
  id_vendor       Int
  date            DateTime
  start_time      String?
  end_time        String?
  is_available    Boolean  @default(true)
  status          String   @default("active")
  date_created    DateTime @default(now())
  date_modified   DateTime @updatedAt
  user_created    String?
  user_modified   String?

  vendor Vendor @relation(fields: [id_vendor], references: [id_vendor])

  @@index([id_vendor])
  @@schema("sigyn")
}

model Booking {
  id_booking     Int      @id @default(autoincrement())
  id_user        Int
  event_date     DateTime
  event_location String?
  total_price    Float
  dp_amount      Float    @default(0)
  status         String   @default("pending")
  notes          String?
  date_created   DateTime @default(now())
  date_modified  DateTime @updatedAt
  user_created   String?
  user_modified  String?

  customer         User             @relation("CustomerBookings", fields: [id_user], references: [id_user])
  booking_packages BookingPackage[]
  payments         BookingPayment[]
  payment_terms    PaymentTerm[]
  review           Review?
  commissions      Commission[]

  @@index([id_user])
  @@schema("sigyn")
}

model BookingPackage {
  id_booking_package Int      @id @default(autoincrement())
  id_booking         Int
  id_package         Int
  date_created       DateTime @default(now())
  user_created       String?

  booking Booking @relation(fields: [id_booking], references: [id_booking], onDelete: Cascade)
  package Package @relation(fields: [id_package], references: [id_package])

  @@unique([id_booking, id_package])
  @@schema("sigyn")
}

model BookingPayment {
  id_booking_payment Int       @id @default(autoincrement())
  id_booking        Int
  amount            Float
  payment_type      String
  status            String    @default("pending")
  payment_proof_url String?
  paid_at           DateTime?
  released_at       DateTime?
  date_created      DateTime  @default(now())
  date_modified     DateTime  @updatedAt
  user_created      String?
  user_modified     String?

  id_term       Int?
  booking Booking @relation(fields: [id_booking], references: [id_booking])
  payment_term    PaymentTerm? @relation(fields: [id_term], references: [id_term])

  @@schema("sigyn")
}

model PaymentTerm {
  id_term        Int      @id @default(autoincrement())
  id_booking     Int
  term_order     Int
  term_name      String
  amount         Float
  due_date       DateTime?
  status         String   @default("unpaid")
  paid_amount    Float    @default(0)
  notes          String?
  date_created   DateTime @default(now())
  date_modified  DateTime @updatedAt
  user_created   String?
  user_modified  String?

  booking  Booking  @relation(fields: [id_booking], references: [id_booking], onDelete: Cascade)
  payments BookingPayment[]

  @@unique([id_booking, term_order])
  @@index([id_booking])
  @@schema("sigyn")
}

model Review {
  id_review     Int      @id @default(autoincrement())
  id_booking    Int      @unique
  id_user       Int
  id_vendor     Int
  rating        Int
  comment       String?
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  booking Booking @relation(fields: [id_booking], references: [id_booking])
  user    User    @relation(fields: [id_user], references: [id_user])
  vendor  Vendor  @relation(fields: [id_vendor], references: [id_vendor])

  @@index([id_user])
  @@index([id_vendor])
  @@schema("sigyn")
}

model Commission {
  id_commission Int      @id @default(autoincrement())
  id_booking    Int
  id_vendor     Int
  percentage    Float
  amount        Float
  status        String   @default("pending")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  booking Booking @relation(fields: [id_booking], references: [id_booking])
  vendor  Vendor  @relation(fields: [id_vendor], references: [id_vendor])

  @@unique([id_booking, id_vendor])
  @@index([id_vendor])
  @@schema("sigyn")
}

model UserFavorite {
  id_favorite  Int      @id @default(autoincrement())
  id_user      Int
  id_package   Int
  date_created DateTime @default(now())

  user    User    @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  package Package @relation(fields: [id_package], references: [id_package], onDelete: Cascade)

  @@unique([id_user, id_package])
  @@schema("sigyn")
}

model Cart {
  id_cart       Int      @id @default(autoincrement())
  id_user       Int      @unique
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt

  user  User       @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  items CartItem[]

  @@schema("sigyn")
}

model CartItem {
  id_cart_item Int      @id @default(autoincrement())
  id_cart      Int
  id_package   Int
  date_created DateTime @default(now())

  cart    Cart    @relation(fields: [id_cart], references: [id_cart], onDelete: Cascade)
  package Package @relation(fields: [id_package], references: [id_package])

  @@unique([id_cart, id_package])
  @@schema("sigyn")
}

model PaymentRequest {
  id_request          Int       @id @default(autoincrement())
  request_number      String    @unique
  title               String
  description         String?
  request_date        DateTime  @default(now())
  requested_by        String
  notes               String?
  payment_method      String?
  bank_account_number String?
  payment_to          String?
  status              String    @default("draft")
  reviewed_by         String?
  reviewed_at         DateTime?
  approval_notes      String?
  receipt_number      String?   @unique
  reference_number    String?
  paid_at             DateTime?
  total_amount        Float     @default(0)
  outstanding         Float     @default(0)
  released_by         String?
  released_at         DateTime?
  date_created        DateTime  @default(now())
  date_modified       DateTime  @updatedAt
  user_created        String?
  user_modified       String?

  items        PaymentRequestItem[]
  transactions PaymentTransaction[]
  terms        PaymentRequestTerm[]
  payments     RfpPayment[]

  @@index([status])
  @@index([requested_by])
  @@index([receipt_number])
  @@schema("sigyn")
}

model PaymentRequestItem {
  id_item      Int      @id @default(autoincrement())
  id_request   Int
  description  String
  quantity     Int      @default(1)
  unit_price   Float    @default(0)
  amount       Float
  notes        String?
  sort_order   Int      @default(0)
  date_created DateTime @default(now())

  request PaymentRequest @relation(fields: [id_request], references: [id_request], onDelete: Cascade)

  @@index([id_request])
  @@schema("sigyn")
}

model PaymentTransaction {
  id_transaction      Int       @id @default(autoincrement())
  id_request          Int
  transaction_date    DateTime  @default(now())
  transaction_type    String
  description         String?
  payment_proof_url   String?
  created_by          String?
  date_created        DateTime  @default(now())

  request PaymentRequest @relation(fields: [id_request], references: [id_request], onDelete: Cascade)

  @@index([id_request])
  @@schema("sigyn")
}

model PaymentRequestTerm {
  id_rfp_term      Int      @id @default(autoincrement())
  id_request   Int
  term_order   Int
  term_name    String
  amount       Float
  paid_amount  Float    @default(0)
  status       String   @default("unpaid")
  due_date     DateTime?
  date_created DateTime @default(now())
  date_modified DateTime @updatedAt

  request  PaymentRequest       @relation(fields: [id_request], references: [id_request], onDelete: Cascade)
  payments RfpPayment[]

  @@unique([id_request, term_order])
  @@index([id_request])
  @@schema("sigyn")
}

model RfpPayment {
  id_rfp_payment        Int       @id @default(autoincrement())
  id_request          Int
  id_rfp_term             Int
  amount              Float
  source_bank         String?
  source_account_number String?
  source_account_name String?
  payment_date        DateTime  @default(now())
  proof_url           String?
  notes               String?
  status              String    @default("pending")
  created_by          String?
  date_created        DateTime  @default(now())
  date_modified       DateTime  @updatedAt

  request PaymentRequest       @relation(fields: [id_request], references: [id_request], onDelete: Cascade)
  term    PaymentRequestTerm   @relation(fields: [id_rfp_term], references: [id_rfp_term], onDelete: Cascade)

  @@index([id_request])
  @@index([id_rfp_term])
  @@schema("sigyn")
}

model CompanyInfo {
  id_company    Int      @id @default(autoincrement())
  company_name  String   @default("Agregrator Business")
  address       String?
  phone         String?
  email         String?
  website       String?
  bank_name     String?
  bank_account  String?
  bank_holder   String?
  footer_text   String?
  logo_url      String?
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  @@schema("sigyn")
}

model ContactMessage {
  id_message    Int      @id @default(autoincrement())
  name          String
  email         String
  subject       String?
  message       String
  is_read       Boolean  @default(false)
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt

  @@schema("sigyn")
}
