generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["sigyn"]
}

model Role {
  id_role       Int         @id @default(autoincrement())
  role_code     String      @unique
  name          String
  status        String      @default("active")
  date_created  DateTime    @default(now())
  date_modified DateTime    @updatedAt
  user_created  String?
  user_modified String?

  user_roles User_Role[]

  @@index([status])
  @@schema("sigyn")
}

model User {
  id_user       Int         @id @default(autoincrement())
  email         String      @unique
  password      String
  full_name     String
  phone         String?
  avatar_url    String?
  is_active     Boolean     @default(true)
  status        String      @default("active")
  date_created  DateTime    @default(now())
  date_modified DateTime    @updatedAt
  user_created  String?
  user_modified String?

  vendor     Vendor?
  bookings   Booking[] @relation("CustomerBookings")
  reviews    Review[]
  orders     Order[]
  carts      Cart[]
  user_roles User_Role[]

  @@index([status])
  @@schema("sigyn")
}

model User_Role {
  iduser_role   Int      @id @default(autoincrement())
  email         String
  role_code     String
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  user User @relation(fields: [email], references: [email])
  role Role @relation(fields: [role_code], references: [role_code])

  @@unique([email, role_code])
  @@index([status])
  @@schema("sigyn")
}

model Vendor {
  id_vendor     Int      @id @default(autoincrement())
  id_user       Int      @unique
  vendor_code   String   @unique @default(uuid())
  business_name String
  description   String?
  category      String
  location      String?
  years_exp     Int      @default(0)
  status        String   @default("pending")
  verified_at   DateTime?
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  avatar_url    String?
  instagram     String?
  vendor_type   String?

  user         User                @relation(fields: [id_user], references: [id_user])
  portfolios   Portfolio[]
  packages     Package[]
  products     Product[]
  orders       Order[]
  availability VendorAvailability[]

  reviews      Review[]
  commissions  Commission[]
  payouts      Payout[]

  @@index([status])
  @@schema("sigyn")
}

model Category {
  id_category   Int      @id @default(autoincrement())
  category_name String   @unique
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  packages   Package[]
  portfolios Portfolio[]

  @@index([status])
  @@schema("sigyn")
}

model Portfolio {
  id_portfolio  Int      @id @default(autoincrement())
  id_vendor     Int
  id_package    Int?
  id_category   Int?
  title         String
  code          String   @unique
  description   String?
  cover_url     String
  location      String?
  label         String?
  sort_order    Int      @default(0)
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  vendor   Vendor           @relation(fields: [id_vendor], references: [id_vendor])
  package  Package?         @relation(fields: [id_package], references: [id_package])
  category Category?        @relation(fields: [id_category], references: [id_category])
  images   PortfolioImage[]

  @@index([id_vendor])
  @@index([id_package])
  @@index([id_category])
  @@schema("sigyn")
}

model PortfolioImage {
  id_image     Int      @id @default(autoincrement())
  id_portfolio Int
  image_url    String
  caption      String?
  sort_order   Int      @default(0)
  date_created DateTime @default(now())

  portfolio Portfolio @relation(fields: [id_portfolio], references: [id_portfolio], onDelete: Cascade)

  @@schema("sigyn")
}

model Package {
  id_package     Int      @id @default(autoincrement())
  id_vendor      Int
  id_category    Int?
  name           String
  description    String?
  price          Float
  duration       String?
  whats_included String?
  status         String   @default("active")
  date_created   DateTime @default(now())
  date_modified  DateTime @updatedAt
  user_created   String?
  user_modified  String?

  vendor           Vendor           @relation(fields: [id_vendor], references: [id_vendor])
  category         Category?        @relation(fields: [id_category], references: [id_category])
  booking_packages BookingPackage[]
  portfolios       Portfolio[]
  extras           PackageExtra[]
  cart_items       CartItem[]

  @@index([id_vendor])
  @@index([id_category])
  @@index([status])
  @@schema("sigyn")
}

model PackageExtra {
  id_extra      Int      @id @default(autoincrement())
  id_package    Int
  name          String
  description   String?
  price         Float
  icon          String?
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  package        Package              @relation(fields: [id_package], references: [id_package])
  booking_extras BookingPackageExtra[]

  @@index([id_package])
  @@index([status])
  @@schema("sigyn")
}

model BookingPackageExtra {
  id_booking_extra   Int      @id @default(autoincrement())
  id_booking_package Int
  id_extra           Int
  name               String
  price              Float
  quantity           Int      @default(1)
  date_created       DateTime @default(now())
  user_created       String?

  booking_package BookingPackage @relation(fields: [id_booking_package], references: [id_booking_package], onDelete: Cascade)
  extra           PackageExtra   @relation(fields: [id_extra], references: [id_extra])

  @@index([id_booking_package])
  @@index([id_extra])
  @@schema("sigyn")
}

model VendorAvailability {
  id_availability Int      @id @default(autoincrement())
  id_vendor       Int
  date            DateTime
  start_time      String?
  end_time        String?
  is_available    Boolean  @default(true)
  status          String   @default("active")
  date_created    DateTime @default(now())
  date_modified   DateTime @updatedAt
  user_created    String?
  user_modified   String?

  vendor Vendor @relation(fields: [id_vendor], references: [id_vendor])

  @@index([id_vendor])
  @@schema("sigyn")
}

model Booking {
  id_booking     Int      @id @default(autoincrement())
  id_user        Int
  event_date     DateTime
  event_location String?
  total_price    Float
  dp_amount      Float    @default(0)
  status         String   @default("pending")
  notes          String?
  date_created   DateTime @default(now())
  date_modified  DateTime @updatedAt
  user_created   String?
  user_modified  String?

  customer         User             @relation("CustomerBookings", fields: [id_user], references: [id_user])
  booking_packages BookingPackage[]
  payments         Payment[]
  review           Review?
  commissions      Commission[]
  payouts          Payout[]

  @@index([id_user])
  @@schema("sigyn")
}

model BookingPackage {
  id_booking_package Int      @id @default(autoincrement())
  id_booking         Int
  id_package         Int
  date_created       DateTime @default(now())
  user_created       String?

  booking Booking @relation(fields: [id_booking], references: [id_booking], onDelete: Cascade)
  package Package @relation(fields: [id_package], references: [id_package])
  extras  BookingPackageExtra[]

  @@unique([id_booking, id_package])
  @@schema("sigyn")
}

model Payment {
  id_payment        Int       @id @default(autoincrement())
  id_booking        Int
  amount            Float
  payment_type      String
  status            String    @default("pending")
  payment_proof_url String?
  paid_at           DateTime?
  released_at       DateTime?
  date_created      DateTime  @default(now())
  date_modified     DateTime  @updatedAt
  user_created      String?
  user_modified     String?

  booking Booking @relation(fields: [id_booking], references: [id_booking])

  @@schema("sigyn")
}

model Review {
  id_review     Int      @id @default(autoincrement())
  id_booking    Int      @unique
  id_user       Int
  id_vendor     Int
  rating        Int
  comment       String?
  status        String   @default("active")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  booking Booking @relation(fields: [id_booking], references: [id_booking])
  user    User    @relation(fields: [id_user], references: [id_user])
  vendor  Vendor  @relation(fields: [id_vendor], references: [id_vendor])

  @@index([id_user])
  @@index([id_vendor])
  @@schema("sigyn")
}

model Commission {
  id_commission Int      @id @default(autoincrement())
  id_booking    Int
  id_vendor     Int
  percentage    Float
  amount        Float
  status        String   @default("pending")
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  booking Booking @relation(fields: [id_booking], references: [id_booking])
  vendor  Vendor  @relation(fields: [id_vendor], references: [id_vendor])

  @@unique([id_booking, id_vendor])
  @@index([id_vendor])
  @@schema("sigyn")
}

model Payout {
  id_payout     Int       @id @default(autoincrement())
  id_vendor     Int
  id_booking    Int
  amount        Float
  status        String    @default("pending")
  paid_at       DateTime?
  date_created  DateTime  @default(now())
  date_modified DateTime  @updatedAt
  user_created  String?
  user_modified String?

  vendor  Vendor  @relation(fields: [id_vendor], references: [id_vendor])
  booking Booking @relation(fields: [id_booking], references: [id_booking])

  @@unique([id_booking, id_vendor])
  @@index([id_vendor])
  @@schema("sigyn")
}

model ProductOccasion {
  id_occasion   Int      @id @default(autoincrement())
  name          String   @unique
  slug          String   @unique
  sort_order    Int      @default(0)
  status        String   @default("active")
  date_created  DateTime @default(now())

  products Product[]

  @@index([status])
  @@schema("sigyn")
}

model ProductType {
  id_type       Int      @id @default(autoincrement())
  name          String   @unique
  slug          String   @unique
  sort_order    Int      @default(0)
  status        String   @default("active")
  date_created  DateTime @default(now())

  @@index([status])
  @@schema("sigyn")
}

model ProductSize {
  id_size       Int      @id @default(autoincrement())
  name          String   @unique
  slug          String   @unique
  sort_order    Int      @default(0)
  status        String   @default("active")
  date_created  DateTime @default(now())

  @@index([status])
  @@schema("sigyn")
}

model Product {
  id_product       Int      @id @default(autoincrement())
  id_vendor        Int
  id_occasion      Int?
  id_template      Int?
  name             String
  description      String?
  price            Float
  stock            Int      @default(0)
  estimated_delivery String?
  delivery_info    String?
  labels           String?
  type_name        String?
  size_name        String?
  status           String   @default("active")
  date_created     DateTime @default(now())
  date_modified    DateTime @updatedAt
  user_created     String?
  user_modified    String?

  vendor   Vendor           @relation(fields: [id_vendor], references: [id_vendor])
  occasion ProductOccasion? @relation(fields: [id_occasion], references: [id_occasion])
  template ProductTemplate? @relation(fields: [id_template], references: [id_template])

  images         ProductImage[]
  variants       ProductVariant[]
  addons         ProductAddon[]
  option_groups  OptionGroup[]
  size_configs   SizeConfig[]
  optional_extras OptionalExtra[]
  cart_items     CartItem[]
  order_items    OrderItem[]

  @@index([id_vendor])
  @@index([id_occasion])
  @@index([id_template])
  @@index([status])
  @@schema("sigyn")
}

model ProductImage {
  id_image     Int      @id @default(autoincrement())
  id_product   Int
  image_url    String
  caption      String?
  sort_order   Int      @default(0)
  date_created DateTime @default(now())

  product Product @relation(fields: [id_product], references: [id_product], onDelete: Cascade)

  @@schema("sigyn")
}

model ProductVariant {
  id_variant   Int      @id @default(autoincrement())
  id_product   Int
  name         String
  price_adjust Float    @default(0)
  stock        Int      @default(0)
  sort_order   Int      @default(0)
  status       String   @default("active")
  date_created DateTime @default(now())

  product Product @relation(fields: [id_product], references: [id_product], onDelete: Cascade)

  @@index([id_product])
  @@schema("sigyn")
}

model ProductAddon {
  id_addon     Int      @id @default(autoincrement())
  id_product   Int
  name         String
  price        Float
  description  String?
  status       String   @default("active")
  date_created DateTime @default(now())

  product Product @relation(fields: [id_product], references: [id_product], onDelete: Cascade)

  @@index([id_product])
  @@schema("sigyn")
}

model ProductTemplate {
  id_template      Int      @id @default(autoincrement())
  name             String   @unique
  slug             String   @unique
  description      String?
  icon             String?
  short_desc       String?
  recommended_use  String?
  suggested_config Json?
  sort_order       Int      @default(0)
  status           String   @default("active")
  date_created     DateTime @default(now())
  date_modified    DateTime @updatedAt

  products Product[]

  @@index([status])
  @@schema("sigyn")
}

model OptionGroup {
  id_option_group Int      @id @default(autoincrement())
  id_product      Int
  name            String
  display_type    String   @default("select")
  sort_order      Int      @default(0)
  is_required     Boolean  @default(false)
  status          String   @default("active")
  date_created    DateTime @default(now())
  date_modified   DateTime @updatedAt

  product Product      @relation(fields: [id_product], references: [id_product], onDelete: Cascade)
  values  OptionValue[]

  @@index([id_product])
  @@schema("sigyn")
}

model OptionValue {
  id_option_value Int      @id @default(autoincrement())
  id_option_group Int
  name            String
  price_adjust    Float    @default(0)
  stock           Int      @default(0)
  sku             String?
  description     String?
  image_url       String?
  sort_order      Int      @default(0)
  status          String   @default("active")
  date_created    DateTime @default(now())
  date_modified   DateTime @updatedAt

  option_group OptionGroup  @relation(fields: [id_option_group], references: [id_option_group], onDelete: Cascade)
  images       ValueImage[]

  @@index([id_option_group])
  @@schema("sigyn")
}

model ValueImage {
  id_value_image  Int      @id @default(autoincrement())
  id_option_value Int
  image_url       String
  sort_order      Int      @default(0)
  date_created    DateTime @default(now())

  option_value OptionValue @relation(fields: [id_option_value], references: [id_option_value], onDelete: Cascade)

  @@schema("sigyn")
}

model SizeConfig {
  id_size_config Int      @id @default(autoincrement())
  id_product     Int
  name           String
  price          Float
  stock          Int      @default(0)
  sku            String?
  sort_order     Int      @default(0)
  status         String   @default("active")
  date_created   DateTime @default(now())
  date_modified  DateTime @updatedAt

  product Product          @relation(fields: [id_product], references: [id_product], onDelete: Cascade)
  images  SizeConfigImage[]

  @@index([id_product])
  @@schema("sigyn")
}

model SizeConfigImage {
  id_size_image  Int      @id @default(autoincrement())
  id_size_config Int
  image_url      String
  sort_order     Int      @default(0)
  date_created   DateTime @default(now())

  size_config SizeConfig @relation(fields: [id_size_config], references: [id_size_config], onDelete: Cascade)

  @@schema("sigyn")
}

model OptionalExtra {
  id_optional_extra Int      @id @default(autoincrement())
  id_product        Int
  name              String
  image_url         String?
  description       String?
  price             Float
  stock             Int      @default(0)
  sort_order        Int      @default(0)
  status            String   @default("active")
  date_created      DateTime @default(now())
  date_modified     DateTime @updatedAt

  product Product @relation(fields: [id_product], references: [id_product], onDelete: Cascade)

  @@index([id_product])
  @@schema("sigyn")
}

model Order {
  id_order       Int      @id @default(autoincrement())
  id_user        Int
  id_vendor      Int
  total_price    Float
  status         String   @default("pending")
  delivery_info  String?
  notes          String?
  date_created   DateTime @default(now())
  date_modified  DateTime @updatedAt
  user_created   String?
  user_modified  String?

  user   User         @relation(fields: [id_user], references: [id_user])
  vendor Vendor       @relation(fields: [id_vendor], references: [id_vendor])
  items  OrderItem[]

  @@index([id_user])
  @@index([id_vendor])
  @@schema("sigyn")
}

model OrderItem {
  id_order_item Int      @id @default(autoincrement())
  id_order      Int
  id_product    Int
  id_variant    Int?
  quantity      Int      @default(1)
  price         Float
  addon_ids     String?
  date_created  DateTime @default(now())

  order   Order   @relation(fields: [id_order], references: [id_order], onDelete: Cascade)
  product Product @relation(fields: [id_product], references: [id_product])

  @@index([id_order])
  @@index([id_product])
  @@schema("sigyn")
}

model Cart {
  id_cart      Int         @id @default(autoincrement())
  id_user      Int         @unique
  date_created DateTime    @default(now())
  date_modified DateTime   @updatedAt

  user  User       @relation(fields: [id_user], references: [id_user])
  items CartItem[]

  @@index([id_user])
  @@schema("sigyn")
}

model CartItem {
  id_cart_item Int      @id @default(autoincrement())
  id_cart      Int
  id_package   Int?
  id_product   Int?
  quantity     Int      @default(1)
  date_created DateTime @default(now())

  cart    Cart     @relation(fields: [id_cart], references: [id_cart], onDelete: Cascade)
  package Package? @relation(fields: [id_package], references: [id_package])
  product Product? @relation(fields: [id_product], references: [id_product])

  @@unique([id_cart, id_package])
  @@unique([id_cart, id_product])
  @@schema("sigyn")
}

model CompanyInfo {
  id_company    Int      @id @default(autoincrement())
  company_name  String   @default("Agregrator Business")
  address       String?
  phone         String?
  email         String?
  website       String?
  bank_name     String?
  bank_account  String?
  bank_holder   String?
  footer_text   String?
  logo_url      String?
  date_created  DateTime @default(now())
  date_modified DateTime @updatedAt
  user_created  String?
  user_modified String?

  @@schema("sigyn")
}
