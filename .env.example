PORT=3000
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://user:password@localhost:5432/postgres?schema=sigyn

# Frontend (VITE_ prefix)
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Agregator Business
VITE_APP_TITLE=Sigyn
VITE_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"

# Midtrans Configuration (Get from https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION=false

# Cloudflare R2 (S3-compatible object storage)
# endpoint = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
# Public/CDN URL R2 (optional) — jika pakai bucket public atau custom domain
R2_PUBLIC_DOMAIN="public-url-of-your-bucket-or-custom-domain"
